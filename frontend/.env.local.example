# Copy to .env.local (gitignored) if your backend isn't on the default port.
#
# The backend's own port is set when you start it:
#   uvicorn app.main:app --port 8000
# Set the same number here so the frontend's /api proxy and the render
# WebSocket both point at it.
NEXT_PUBLIC_BACKEND_PORT=8000

# --- Auth (hosted deployment only) --------------------------------------
# Leave both empty for a self-hosted install: no accounts, no login screen,
# no credits. The app checks for these rather than a separate flag, so the
# two shapes can't drift apart.
#
# Both values are public by design. The publishable key only lets the
# browser start a login flow; it grants no data access. Never put a
# Supabase *secret* key in a NEXT_PUBLIC_* variable — those are compiled
# into the JavaScript sent to every visitor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Deployment only ----------------------------------------------------
# Where the render-progress WebSocket connects. REST goes through this
# server's /api proxy, but rewrites don't proxy protocol upgrades, so the
# socket reaches the backend itself.
#
# Unset, it assumes the same host on NEXT_PUBLIC_BACKEND_PORT, which is
# right in development. Behind a reverse proxy the backend has no port of
# its own, so point this at the public origin — the proxy routes /ws to
# the API. Compiled into the client bundle, so it must be set at build time.
NEXT_PUBLIC_WS_ORIGIN=

# Server-side only: where this Next server proxies /api to. A host, not a
# port — in a container `localhost` is the container itself.
BACKEND_ORIGIN=
