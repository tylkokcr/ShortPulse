# Deployment identity, for docker-compose.prod.yml.
#
#     cp .env.production.example .env      (next to docker-compose.yml)
#
# Nothing here is secret — these are addresses and public identifiers, and
# the NEXT_PUBLIC_* ones are compiled into the JavaScript every visitor
# downloads. API keys and database passwords go in backend/.env instead,
# which the API container reads and the web build never sees.
#
# Check the result rather than trusting it: GET /api/health lists every
# setting that is wrong in a way nothing else would report.

# The domain, bare — no scheme, no trailing slash. Caddy obtains the
# certificate for exactly this name, and the web image bakes wss://<it>
# into the client bundle.
SITE_ADDRESS=shortpulse.example

# --- Accounts -----------------------------------------------------------
# From Supabase: Settings -> API. Both are public by design; the project
# must use an asymmetric JWT signing key (ES256), or the backend has no
# JWKS to verify tokens against and every login fails.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Sign-in providers ---------------------------------------------------
# Which buttons the /login screen offers, comma separated. A provider only
# works once it has a client id and secret in the Supabase dashboard
# (Authentication -> Providers), so this list and that dashboard have to
# agree — a name here that isn't enabled there is a button that fails when
# someone presses it.
#
# Google needs only an OAuth consent screen and can be enabled as soon as
# it is configured. Facebook additionally needs Meta business
# verification, which wants a registered company — so it stays out of this
# list until the JDG named below is real, and goes in on the same day
# Instagram publishing does.
#
# Empty means email links only. The email option never goes away
# regardless: Facebook accounts registered against a phone number hand
# over no email address, and every account created before this existed was
# created by a link.
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# --- Who runs this ------------------------------------------------------
# Printed on /terms and /privacy. GDPR requires the controller's identity
# and a working contact; unset, those pages say the operator has not
# published them rather than showing a name nobody answers to.
#
# The address has to be one that is actually monitored — it is where
# erasure requests and security reports arrive.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_TAX_ID=
# Spelled out, for "governed by the law of ___".
OPERATOR_COUNTRY=
# Spelled out, for "data is held in ___". A claim, so keep it true: it has
# to change when the database does.
OPERATOR_DATA_REGION=
