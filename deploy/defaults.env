# Defaults for the self-hosted shape, read by the api service.
#
# These used to sit in docker-compose.yml under `environment:`, which was
# wrong in a way nothing reported: `environment:` outranks `env_file:`, so
# a value set here in backend/.env was silently discarded. The hosted
# deployment kept its Supabase DATABASE_URL in backend/.env and would have
# run on the throwaway `db` container regardless — accounts, credits and
# purchases landing in a container volume with a default password.
#
# As an env_file listed *before* backend/.env they are ordinary defaults:
# anything the operator sets wins, anything they leave out falls back here.
# Values that must beat backend/.env — the ffmpeg paths, which are the
# image's and not the host's — stay in `environment:` on purpose.

# The compose Postgres. The hosted shape points this at Supabase from
# backend/.env instead, and leaves this container running but unused.
DATABASE_URL=postgresql://shortpulse:shortpulse@db:5432/shortpulse

# Ollama runs on the host, not in this compose file — it wants the
# machine's GPU and its own model cache.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# The proxy's port, which is the only origin the UI is served from. The
# hosted shape derives this from SITE_ADDRESS instead.
CORS_ORIGINS=["http://localhost:8080"]
