# One origin for the UI, the API and the WebSocket.
#
# Serving them separately is possible but means CORS on every request and a
# second public port for the socket. Routing by path keeps the browser
# talking to exactly one host, which is also what the media tokens and the
# cookie-free auth assume.

# SITE_ADDRESS is the domain in production and unset everywhere else, where
# it falls back to plain :80 for `docker compose up` on a laptop. Given a
# domain, Caddy obtains and renews the certificate itself — that is the
# whole reason it is the proxy here rather than nginx.
{$SITE_ADDRESS::80} {
	encode gzip

	# Security headers on every response.
	#
	# None of these were being sent, which for a public deployment is a
	# gap in itself. What each one buys:
	#   - HSTS: the browser refuses plain HTTP to this host for a year,
	#     closing the one-request downgrade window the 308 redirect leaves
	#     open. preload-eligible, but not submitted anywhere yet.
	#   - X-Frame-Options DENY: the app can't be framed, so the sign-in
	#     screen can't be clickjacked. CSP frame-ancestors says the same to
	#     newer browsers; both are cheap.
	#   - nosniff: a response typed text/plain can't be reinterpreted as
	#     script by MIME sniffing.
	#   - Referrer-Policy: a click out never leaks the full path — media
	#     URLs carry a signed token in the query string, and this keeps it
	#     out of a third party's referer log.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"

		# Content-Security-Policy, deliberately split across two headers.
		#
		# A wrong CSP breaks a page silently — the browser blocks a script
		# and nothing in the UI says why — so the policy is rolled out in
		# the order of what can be proven. Enforced here is only the part
		# that cannot break this app, because it forbids things the app has
		# never contained: there is no <object> or <embed>, no <base>, no
		# iframe, and no form that posts anywhere but this origin. Each one
		# closes a real injection route — <base> rewrites every relative URL
		# on the page, and form-action is how an injected form exfiltrates a
		# password field.
		Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# The rest of the policy rides along as Report-Only: browsers apply
		# it, report what it would have blocked to the console, and block
		# nothing. Flip it into the header above once a signed-in session
		# has been clicked through with the console open — the editor, a
		# render and the library are the pages this file cannot reach from
		# outside.
		#
		# Measured against the deployed bundle rather than guessed at:
		#   - 'unsafe-inline' for scripts is not optional here. Next inlines
		#     a hydration script whose contents differ per page, so a hash
		#     can't cover it, and a nonce would mean rendering every page
		#     per-request and giving up the prerendering the cache rules
		#     above depend on. The accent boot script in app/layout.tsx is
		#     inline for the same reason it exists: it must run before the
		#     first paint.
		#   - style likewise: React writes style="" attributes throughout.
		#   - data: for images is the SVG noise texture the page background
		#     is built from; blob: is the local preview of a file the user
		#     picked, before it is uploaded (components/editor/UploadPreview).
		#   - connect-src is the interesting one, and the reason the rest is
		#     worth having: it is what stops injected script from posting a
		#     token or a script to somewhere else. Supabase is the only
		#     third party the browser talks to, and the socket origin is
		#     the render progress feed. Both are taken from the variables
		#     the web image is built with rather than written out again
		#     here, because a policy that names a different host than the
		#     bundle calls is a policy that blocks the app.
		# Verified with zero violations on /, /login, /credits, /library,
		# /terms, /privacy, /reset-password and /settings/connections.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' {$SUPABASE_ORIGIN:} {$WS_ORIGIN:ws://localhost:8080}; frame-src 'none'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Drop the framework fingerprint Next sets on every response.
		-X-Powered-By
	}

	# Render progress. Matched before /api/* because it is a protocol
	# upgrade rather than a request/response, and Caddy proxies it as one.
	handle /ws/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		# Rendered video is served from here, and a long render can hold a
		# request open — the default 30s would cut both off.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Content-hashed by the build — the filename changes whenever the bytes
	# do — so these can be cached forever and never revalidated. This is the
	# half of caching that is safe to be aggressive about.
	handle /_next/static/* {
		reverse_proxy web:3000 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	# Everything else, HTML included.
	#
	# Next serves a prerendered page with `s-maxage=31536000` and no
	# `max-age`. s-maxage binds shared caches only, so a browser sees a
	# response with no freshness information at all and falls back to
	# heuristic caching — it may reuse the document for a long time without
	# ever asking. The symptom is a returning visitor being shown a build
	# from weeks ago while everyone else sees the current one, which is
	# exactly what happened here.
	#
	# `no-cache` does not mean "don't store": the copy is kept and
	# revalidated. An unchanged page still costs one 304, and a deploy is
	# picked up on the next visit rather than whenever the browser happens
	# to give up on its guess.
	handle {
		reverse_proxy web:3000 {
			header_down Cache-Control "no-cache"
		}
	}
}
