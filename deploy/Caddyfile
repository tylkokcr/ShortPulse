# One origin for the UI, the API and the WebSocket.
#
# Serving them separately is possible but means CORS on every request and a
# second public port for the socket. Routing by path keeps the browser
# talking to exactly one host, which is also what the media tokens and the
# cookie-free auth assume.

# SITE_ADDRESS is the domain in production and unset everywhere else, where
# it falls back to plain :80 for `docker compose up` on a laptop. Given a
# domain, Caddy obtains and renews the certificate itself — that is the
# whole reason it is the proxy here rather than nginx.
{$SITE_ADDRESS::80} {
	encode gzip

	# Security headers on every response.
	#
	# None of these were being sent, which for a public deployment is a
	# gap in itself. What each one buys:
	#   - HSTS: the browser refuses plain HTTP to this host for a year,
	#     closing the one-request downgrade window the 308 redirect leaves
	#     open. preload-eligible, but not submitted anywhere yet.
	#   - X-Frame-Options DENY: the app can't be framed, so the sign-in
	#     screen can't be clickjacked. CSP frame-ancestors says the same to
	#     newer browsers; both are cheap.
	#   - nosniff: a response typed text/plain can't be reinterpreted as
	#     script by MIME sniffing.
	#   - Referrer-Policy: a click out never leaks the full path — media
	#     URLs carry a signed token in the query string, and this keeps it
	#     out of a third party's referer log.
	# No Content-Security-Policy beyond frame-ancestors: a real one has to
	# be built against what the Next bundle actually loads, and a wrong one
	# breaks the page silently. That is its own task, not a one-liner here.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Drop the framework fingerprint Next sets on every response.
		-X-Powered-By
	}

	# Render progress. Matched before /api/* because it is a protocol
	# upgrade rather than a request/response, and Caddy proxies it as one.
	handle /ws/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		# Rendered video is served from here, and a long render can hold a
		# request open — the default 30s would cut both off.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Content-hashed by the build — the filename changes whenever the bytes
	# do — so these can be cached forever and never revalidated. This is the
	# half of caching that is safe to be aggressive about.
	handle /_next/static/* {
		reverse_proxy web:3000 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	# Everything else, HTML included.
	#
	# Next serves a prerendered page with `s-maxage=31536000` and no
	# `max-age`. s-maxage binds shared caches only, so a browser sees a
	# response with no freshness information at all and falls back to
	# heuristic caching — it may reuse the document for a long time without
	# ever asking. The symptom is a returning visitor being shown a build
	# from weeks ago while everyone else sees the current one, which is
	# exactly what happened here.
	#
	# `no-cache` does not mean "don't store": the copy is kept and
	# revalidated. An unchanged page still costs one 304, and a deploy is
	# picked up on the next visit rather than whenever the browser happens
	# to give up on its guess.
	handle {
		reverse_proxy web:3000 {
			header_down Cache-Control "no-cache"
		}
	}
}
