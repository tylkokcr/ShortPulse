# backend/.env for the hosted deployment.
#
# .env.example is the self-hosted shape and documents every setting. This
# is the subset that has to change to take real users and real money, with
# the reason each one matters. Copy it to backend/.env and fill it in.
#
# The whole list is checked at startup and reported on /api/health, so a
# deploy script can refuse to promote a build rather than trusting that
# someone read this file. `"warnings": []` is the goal.

# --- The two switches that cost money if left alone ---------------------

# Without this an anonymous caller looks like a self-hoster to the code and
# renders for free — on your hardware, with your OpenAI key.
REQUIRE_AUTH=true

# Signs the tokens in video URLs. Unset, each process invents its own:
# every video link breaks on restart, and none of them validate across
# more than one instance. Generate with:  openssl rand -base64 32
MEDIA_URL_SECRET=

# --- Script generation --------------------------------------------------
# An 8B local model needs ~6GB of RAM and, on a cheap vCPU, takes longer to
# write the script than the rest of the pipeline takes to make the video.
# Set a spending limit on the key; a short costs well under a cent.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Stock footage ------------------------------------------------------
# The only visual mode the shipped image can run — the diffusion stack is
# left out because it needs a GPU to be worth anything. Without a key here
# there is no mode left that works, and the API says so instead of selling
# one that silently falls back.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Persistence --------------------------------------------------------
# Supabase, session pooler, port 5432. Not the transaction pooler on 6543:
# asyncpg uses prepared statements and they do not survive it.
DATABASE_URL=

# --- Accounts -----------------------------------------------------------
# Project URL from Settings -> API. The project must sign with an
# asymmetric key (Settings -> JWT Signing Keys, ES256); a legacy HS256
# secret publishes no JWKS and every login fails.
SUPABASE_URL=
SIGNUP_CREDIT_GRANT=15

# --- Payments -----------------------------------------------------------
# The live key, and the signing secret from the dashboard endpoint — not
# the one `stripe listen` printed, they are different. Without the secret
# the webhook cannot be verified, so purchases never grant credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reinterprets the numbers in credits.CREDIT_PACKS rather than converting
# them: 900 becomes EUR 9.00, not the euro equivalent of $9.
STRIPE_CURRENCY=eur

# VAT on digital sales to EU consumers is owed at the buyer's local rate
# whether or not it was charged, so unset it comes out of revenue. Requires
# Stripe Tax to be activated with an origin address — without that the
# checkout call fails outright rather than degrading.
STRIPE_AUTOMATIC_TAX=true

# Where Stripe returns the buyer. Must be the real domain: with live keys
# and a localhost URL, a paying customer is sent to a page that does not
# exist for them.
CHECKOUT_SUCCESS_URL=https://shortpulse.example/credits?purchase=ok
CHECKOUT_CANCEL_URL=https://shortpulse.example/credits

# --- Server -------------------------------------------------------------
# CORS_ORIGINS is not set here. docker-compose.prod.yml derives it from
# SITE_ADDRESS, because the deployment serves exactly one origin and a
# second place to write the domain is a second place for it to go stale.
# Setting it here has no effect: `environment:` outranks `env_file:`.

# Renders are CPU-bound here. Raising this past what the box can do makes
# every concurrent render slower rather than getting more of them done.
MAX_CONCURRENT_RENDERS=2

# --- Knowing when it breaks ---------------------------------------------
# A failed render is caught, written to the project row and shown to the
# user, which means the exception never leaves the process. Without this
# the first you hear of a broken pipeline is a customer telling you, by
# which point it has failed for everyone. Optional, and inert unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
