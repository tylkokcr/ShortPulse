# backend/.env for the hosted deployment.
#
# .env.example is the self-hosted shape and documents every setting. This
# is the subset that has to change to take real users and real money, with
# the reason each one matters. Copy it to backend/.env and fill it in.
#
# The whole list is checked at startup and reported on /api/health, so a
# deploy script can refuse to promote a build rather than trusting that
# someone read this file. `"warnings": []` is the goal.

# --- The two switches that cost money if left alone ---------------------

# Without this an anonymous caller looks like a self-hoster to the code and
# renders for free — on your hardware, with your OpenAI key.
REQUIRE_AUTH=true

# Signs the tokens in video URLs. Unset, each process invents its own:
# every video link breaks on restart, and none of them validate across
# more than one instance. Generate with:  openssl rand -base64 32
MEDIA_URL_SECRET=

# --- Script generation --------------------------------------------------
# An 8B local model needs ~6GB of RAM and, on a cheap vCPU, takes longer to
# write the script than the rest of the pipeline takes to make the video.
# Set a spending limit on the key; a short costs well under a cent.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Stock footage ------------------------------------------------------
# The `stock_media` visual mode. Without a key here that mode cannot fetch
# clips, and it is also what every other mode falls back to when
# generation fails — so an install with no key here has no safety net.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Image generation ---------------------------------------------------
# `fast_hybrid` on a machine with no GPU. The shipped image leaves the
# diffusion stack out (~3GB, and pointless without a card), so the mode
# runs the same RealVisXL checkpoint on Replicate's hosted inference
# instead — about $0.004 an image, against 3 credits for a render of five
# or six of them.
#
# Strictly optional: leave the token empty and the deployment serves
# `stock_media` only, which is what it did before this existed. The API
# refuses a mode it cannot run rather than quietly downgrading it.
#
# Set a spending limit on the token. It is the only bound on what an
# abused free tier can cost — the signup grant limits one account, not
# how many accounts there are.
VISUAL_PROVIDER=replicate
REPLICATE_API_TOKEN=

# `ai_video` is deliberately not offered here. Hosted text-to-video costs
# more per render than the 10 credits it is priced at, so the mode stays
# self-hosted-only and the API says so.

# --- Persistence --------------------------------------------------------
# Supabase, session pooler, port 5432. Not the transaction pooler on 6543:
# asyncpg uses prepared statements and they do not survive it.
DATABASE_URL=

# --- Accounts -----------------------------------------------------------
# Project URL from Settings -> API. The project must sign with an
# asymmetric key (Settings -> JWT Signing Keys, ES256); a legacy HS256
# secret publishes no JWKS and every login fails.
SUPABASE_URL=
SIGNUP_CREDIT_GRANT=5

# --- Payments -----------------------------------------------------------
# The live key, and the signing secret from the dashboard endpoint — not
# the one `stripe listen` printed, they are different. Without the secret
# the webhook cannot be verified, so purchases never grant credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reinterprets the numbers in credits.CREDIT_PACKS rather than converting
# them: 900 becomes EUR 9.00, not the euro equivalent of $9.
STRIPE_CURRENCY=eur

# VAT on digital sales to EU consumers is owed at the buyer's local rate
# whether or not it was charged, so unset it comes out of revenue. Requires
# Stripe Tax to be activated with an origin address — without that the
# checkout call fails outright rather than degrading.
STRIPE_AUTOMATIC_TAX=true

# Where Stripe returns the buyer. Must be the real domain: with live keys
# and a localhost URL, a paying customer is sent to a page that does not
# exist for them.
CHECKOUT_SUCCESS_URL=https://shortpulse.example/credits?purchase=ok
CHECKOUT_CANCEL_URL=https://shortpulse.example/credits

# --- Server -------------------------------------------------------------
# CORS_ORIGINS is not set here. docker-compose.prod.yml derives it from
# SITE_ADDRESS, because the deployment serves exactly one origin and a
# second place to write the domain is a second place for it to go stale.
# Setting it here has no effect: `environment:` outranks `env_file:`.

# Renders are CPU-bound here. Raising this past what the box can do makes
# every concurrent render slower rather than getting more of them done.
MAX_CONCURRENT_RENDERS=2

# --- Knowing when it breaks ---------------------------------------------
# A failed render is caught, written to the project row and shown to the
# user, which means the exception never leaves the process. Without this
# the first you hear of a broken pipeline is a customer telling you, by
# which point it has failed for everyone. Optional, and inert unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Publishing to TikTok / Instagram / YouTube -------------------------
# Where this deployment is reachable from the public internet, no trailing
# slash. Used for the OAuth redirect_uri, which must match the platform's
# developer console character for character, and for the video URL that
# Instagram and TikTok fetch themselves. A localhost value here is not a
# harmless default: it asks those platforms to download the video from
# their own machines, which fails as a media error with nothing pointing
# back at this setting.
PUBLIC_BASE_URL=https://shortpulse.app

# Encrypts the platform tokens before they are written. Without it there
# is no publishing at all — the alternative would be storing somebody's
# YouTube credentials as readable text. Generate with:
#
#     openssl rand -base64 48
#
# Changing it orphans every connected account: users reconnect, which is
# one OAuth round trip and the only honest recovery.
SOCIAL_TOKEN_SECRET=

# YouTube upload, from the same Google Cloud project as the sign-in
# client but a *separate* OAuth client — this one redirects to our own API
# rather than to Supabase, because the tokens it returns must never reach
# the browser. Its authorised redirect URI is:
#
#     https://shortpulse.app/api/social/callback/youtube
#
# Until the project passes Google's audit every upload is forced to
# private, whatever visibility is requested. That is reported in the UI
# rather than treated as an error.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram Reels and Facebook Page video, via the Graph API. One Meta
# app serves both — setting these offers both destinations or neither.
#
# The authorised redirect URIs to register are:
#
#     https://shortpulse.app/api/social/callback/instagram
#     https://shortpulse.app/api/social/callback/facebook
#
# Posting for anyone but the app's own developer needs Meta business
# verification. Instagram additionally needs the *user* to have a
# Business or Creator account linked to a Page: personal accounts cannot
# be posted to by any app, and that is refused when connecting.
META_APP_ID=
META_APP_SECRET=

# TikTok, via the Content Posting API. `client_key` is TikTok's name for
# the client id.
#
#     https://shortpulse.app/api/social/callback/tiktok
#
# Videos arrive as drafts in the user's TikTok inbox for them to caption
# and post — direct posting is a separate scope and a separate review.
# Until the app is approved, uploads are capped at five users per 24
# hours. TikTok fetches the file rather than receiving it, so this
# deployment's domain must also be verified under URL properties in the
# developer portal, or every upload fails with url_ownership_unverified.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
