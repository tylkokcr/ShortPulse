# Copy to .env and adjust. Every value here has a working default in
# app/core/config.py — you only need to set what you want to change.

# --- LLM ------------------------------------------------------------
# These are the only values the script engine runs with. A request's own
# `llm` block is discarded at the HTTP boundary — `base_url` is an address
# the server would then POST to, which is a request forgery waiting to
# happen, and the model is a deployment decision anyway.
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Set LLM_PROVIDER=openai and fill this in on a hosted deployment. An 8B
# model wants ~6GB of RAM, and on a modest VPS CPU it takes longer to write
# the script than the rest of the pipeline takes to make the video —
# measured at 21 tokens/sec on Apple Silicon, and a cheap vCPU is slower
# still. gpt-4o-mini answers in a second or two for a fraction of a cent.
OPENAI_API_KEY=

# --- TTS / ASR --------------------------------------------------------
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Visual generation --------------------------------------------------
# Free stock footage for the `stock_media` visual mode. Get a key in a
# couple of minutes at https://www.pexels.com/api/ (email signup, no card).
# Without one, `stock_media` cannot fetch clips.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# "cuda" on an NVIDIA GPU, "mps" on Apple Silicon, "cpu" otherwise.
DIFFUSION_DEVICE=cpu

# Image model for the `fast_hybrid` visual mode. The default (set in
# app/core/config.py) is the photorealistic RealVisXL_V4.0 at 25 steps —
# ~7GB one-time download and roughly 59s per scene on Apple Silicon.
#
# Uncomment the block below for the fast alternative: ~5s per scene, but
# visibly more "AI-looking". Note guidance_scale=0.0 disables
# classifier-free guidance, so negative prompts stop having any effect.
#SDXL_MODEL_ID=stabilityai/sdxl-turbo
#SDXL_MODEL_VARIANT=
#SDXL_NUM_INFERENCE_STEPS=4
#SDXL_GUIDANCE_SCALE=0.0

# --- Rendering --------------------------------------------------------
# NOTE: Homebrew's default `ffmpeg` formula on macOS ships without libass,
# so the `ass`/`subtitles` filters used by render_engine.py are unavailable.
# Install `brew install ffmpeg-full` (keg-only) and point these at it, e.g.
# /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg — or use any ffmpeg build compiled
# with --enable-libass.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Silence appended after each scene's voiceover. Scene clips play back to
# back, so with no gap one sentence ends and the next starts in the same
# instant — the narrator sounds like they're interrupting themselves.
# Raise it for a slower read, set 0 to butt the lines together.
SCENE_GAP_S=0.35

# --- Payments (hosted deployment only) ----------------------------------
# Leave empty on a self-hosted install: renders are free there, the
# checkout endpoints report themselves unavailable, and no card is ever
# involved.
#
# Setting it up, in test mode:
#   1. Create a Stripe account and copy the *test* secret key
#      (dashboard.stripe.com/test/apikeys — it starts sk_test_).
#   2. Forward webhooks to this machine:
#        stripe listen --forward-to localhost:8002/api/credits/webhook
#      That prints a signing secret starting whsec_ — that is the one
#      below, and it is different from the one shown in the dashboard.
#   3. Pay with card 4242 4242 4242 4242, any future expiry, any CVC.
#
# STRIPE_WEBHOOK_SECRET is not optional once the webhook route is
# reachable: the handler grants credits, so an unverified payload is a
# free-credits endpoint for anyone who finds the URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# What the packs are priced in. Changing it reinterprets the numbers in
# credits.CREDIT_PACKS rather than converting them: 900 becomes EUR 9.00,
# not the euro equivalent of $9. A business selling from the EU probably
# wants eur.
STRIPE_CURRENCY=usd

# Let Stripe work out and collect VAT. Requires Stripe Tax to be activated
# with an origin address in the dashboard — without that the checkout call
# fails outright, which is why this is off by default rather than on.
#
# Selling digital services to EU consumers means VAT at the buyer's local
# rate, owed whether or not it was charged. Prices are sent tax-inclusive,
# so the advertised price is what gets paid and the tax comes out of it.
STRIPE_AUTOMATIC_TAX=false

# Where Stripe returns the customer. Must point at this app.
CHECKOUT_SUCCESS_URL=http://localhost:3000/credits?purchase=ok
CHECKOUT_CANCEL_URL=http://localhost:3000/credits

# --- Persistence --------------------------------------------------------
# Leave empty to keep projects in memory — fine for a single-user local
# install, but everything is lost on restart, including in-flight renders.
# Set it to persist projects (and, later, credits). Supabase gives you a
# connection string under Settings -> Database; for a local container:
#   docker run -d --name shortpulse-pg -e POSTGRES_PASSWORD=shortpulse \
#       -e POSTGRES_DB=shortpulse -p 55432:5432 postgres:17-alpine
# Migrations in migrations/ are applied automatically at startup.
DATABASE_URL=

# --- Auth (hosted deployment only) --------------------------------------
# Leave SUPABASE_URL empty for a self-hosted install: requests are
# anonymous, renders are free, and none of this code runs.
#
# Set it to your project URL (Settings -> API) to verify Supabase access
# tokens. No secret goes here — tokens are checked against the project's
# public JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Your project
# must use an asymmetric signing key (Settings -> JWT Signing Keys, ES256
# recommended); a legacy HS256 shared secret publishes no JWKS and every
# login will fail.
SUPABASE_URL=
# Reject unauthenticated requests. Must be true on a public deployment:
# without it an anonymous caller is treated as a self-hoster and renders
# for free.
REQUIRE_AUTH=false
# Credits given the first time a user authenticates. This is real compute
# given away, so set it deliberately — a self-hosted install charges
# nothing and can leave it at 0.
#
# The hosted deployment uses 15: five fast_hybrid shorts, or fifteen
# stock_media shorts. Enough to judge the output before paying, small
# enough that farming new addresses isn't worth the effort.
SIGNUP_CREDIT_GRANT=15
# Signs the short-lived tokens in video URLs. A <video> tag can't send an
# Authorization header, so playback of an owned project needs its
# credential in the URL — the same shape as an S3 presigned link.
#
# Leave empty and one is generated per process: fine for a single local
# instance, but video links then break on every restart and don't validate
# across replicas. Generate one with:  openssl rand -base64 32
MEDIA_URL_SECRET=
MEDIA_URL_TTL_S=900

# --- Throttling ---------------------------------------------------------
# Credits bound what a render costs, not how fast someone can ask for one.
# Counted per authenticated user, or per client address when anonymous.
# State is per-process, so with several instances the effective limit is
# multiplied by the instance count.
RENDER_SUBMISSIONS_PER_HOUR=30
API_REQUESTS_PER_MINUTE=120

# --- Server ------------------------------------------------------------
# Next.js dev falls back to 3001/3002 when 3000 is already taken, so allow
# the whole range rather than pinning one port.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
MAX_CONCURRENT_RENDERS=2
