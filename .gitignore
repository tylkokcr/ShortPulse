# Deployment identity for docker-compose.prod.yml — the domain, the
# Supabase project, who operates the service. No secrets belong here (they
# go in backend/.env), but it describes one particular deployment and is
# not something a fork should inherit. .env.production.example is the
# tracked copy.
#
# The glob covers the copies that get made by hand — .env.old,
# .env.singapore-backup — because those hold whatever the live file held
# at the time, and the exact-name rule below would not have stopped one
# from being committed.
/.env
/.env.*
!/.env.production.example

# Python
__pycache__/
*.pyc
backend/.venv/
backend/venv/
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.production.example
backend/app/storage/projects/*
!backend/app/storage/projects/.gitkeep
backend/.pytest_cache/
backend/.ruff_cache/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# OS
.DS_Store
# Synthesized voice samples, regenerated on demand
backend/app/storage/voice_previews/

# Example renders shown on the landing page. The .mp4 masters are ~26MB
# and are regenerated from the pipeline (see
# frontend/public/examples/README.md); the .jpg posters stay tracked so a
# fresh clone still renders the page with the right thumbnails.
frontend/public/examples/*.mp4

# Cloudflare wrangler's local cache. No wrangler project lives here — this
# is what one run in the wrong directory leaves behind, and it holds the
# account id, which has no business in the repository.
.wrangler/
